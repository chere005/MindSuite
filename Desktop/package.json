{
	"name": "mindsuite-desktop",
	"productName": "MindSuite",
	"version": "0.3.0",
	"private": true,
	"description": "The MindSuite desktop workspace.",
	"author": {
		"name": "MindSuite"
	},
	"homepage": "https://seancheren.com/MindSuite/",
	"main": "main.cjs",
	"scripts": {
		"start": "npm run stage:mac && electron .",
		"check": "node --test test/*.test.cjs",
		"build:mac": "npm run stage:mac && electron-builder --mac dir --arm64 --publish never",
		"build:windows": "electron-builder --win nsis --x64 --arm64 --publish never",
		"build:linux": "electron-builder --linux AppImage deb --x64 --arm64 --publish never",
		"stage:mac": "node stage-local.cjs",
		"test:mac": "node test/smoke.cjs",
		"release:mac": "node tools/release-mac.cjs",
		"publish:mac": "node tools/publish-desktop.cjs",
		"install:mac": "sh tools/mac-sign-install.sh --install-prebuilt dist/release/signed/MindSuite.app",
		"test:update": "node test/update-e2e.cjs"
	},
	"dependencies": {
		"electron-updater": "6.8.12"
	},
	"devDependencies": {
		"electron": "44.11.3",
		"electron-builder": "26.18.0",
		"@electron/asar": "3.4.1"
	},
	"build": {
		"appId": "com.seancheren.mindsuite",
		"icon": "assets/icon.png",
		"files": [
			"*.cjs",
			"shell.html",
			"shell.css",
			"shell.js",
			"picker.js",
			"picker.css",
			"assets/icon.png",
			"assets/apps/*.svg"
		],
		"electronFuses": {
			"runAsNode": false,
			"enableNodeOptionsEnvironmentVariable": false,
			"enableNodeCliInspectArguments": false,
			"enableEmbeddedAsarIntegrityValidation": true,
			"onlyLoadAppFromAsar": true
		},
		"mac": {
			"category": "public.app-category.productivity",
			"identity": "-",
			"hardenedRuntime": false,
			"notarize": false,
			"extendInfo": {
				"NSCameraUsageDescription": "NoteMind uses the camera to capture pages and pictures."
			},
			"extraResources": [
				{
					"from": "runtime",
					"to": "mindsuite-local"
				},
				{
					"from": "app-update.yml",
					"to": "app-update.yml"
				}
			]
		},
		"win": {
			"artifactName": "${productName}-${version}-Setup.${ext}"
		},
		"linux": {
			"category": "Office"
		}
	}
}
