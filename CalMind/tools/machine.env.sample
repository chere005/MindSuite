# Copy to <app>/.local/machine.env (gitignored) and fill in this machine's values.
# Plain sh, KEY=value. Nothing here is a real value; the real file never leaves
# the machine. See tools/machine-env.sh.

# Apple developer team that signs the device builds (10 characters).
APPLE_TEAM_ID=TEAMID0000

# Handsets, by UDID (never by name: a name can carry a curly apostrophe).
PHONE1_UDID=00000000-0000000000000001
PHONE1_NAME="Phone 1"
PHONE1_PERSON="Person A"
PHONE2_UDID=00000000-0000000000000002
PHONE2_NAME="Phone 2"
PHONE2_PERSON="Person B"
PHONE3_UDID=00000000-0000000000000003
PHONE3_NAME="Phone 3"
PHONE3_PERSON="Person C"

# Which phones each app installs on (indexes above, space separated).
CALMIND_PHONES="1 2 3"
CHEFMIND_PHONES="1 2"
ACCTMIND_PHONES="1"
PLANMIND_PHONES="1 2"
TASKMIND_PHONES="1 2"

# The people the lanes install for, as they appear in lane messages.
PERSON_A="Person A"
PERSON_B="Person B"
PERSON_C="Person C"
