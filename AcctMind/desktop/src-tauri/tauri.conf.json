{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AcctMind",
  "version": "1.2.0",
  "identifier": "com.seancheren.acctmind.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "sh stage-dist.sh",
    "beforeDevCommand": "sh stage-dist.sh"
  },
  "app": {
    "windows": [
      {
        "title": "AcctMind",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#111111",
        "url": "/AcctMind/index.html"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQUFFRDY3QTNGNzA4QTQKUldTa0NQZWpaKzJxc21SRWxDdGxkcFlVSllncEFkRi9yTmdBeWNTNCtiTjcxK0ZGbHFlMWlaRU0K",
      "endpoints": [
        "https://github.com/chere005/MindSuite/releases/download/AcctMind-updates/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "category": "Finance"
  }
}
