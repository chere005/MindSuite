{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../CoreMind/node_modules/@types"],
    "paths": {
      "vitest": ["../../CoreMind/node_modules/vitest"]
    }
  },
  "include": ["src", "test"]
}
