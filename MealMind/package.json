{
  "name": "mealmind",
  "private": true,
  "workspaces": [
    "packages/*",
    "app",
    "desktop"
  ],
  "scripts": {
    "test": "npm run test:core && npm run test:app",
    "test:core": "npm -w @calmind/core run test -- --run",
    "test:app": "npx vitest run --root app",
    "test:desktop": "sh tools/test-desktop.sh",
    "test:lane": "sh tools/test-publish-update.sh",
    "web": "npm -w mealmind-app run web",
    "export:web": "npm -w mealmind-app exec expo export -- -p web",
    "desktop": "npm -w @mealmind/desktop run build",
    "desktop:dev": "npm -w @mealmind/desktop run dev",
    "typecheck": "npx tsc --noEmit -p packages/core && npx tsc --noEmit -p app",
    "deploy": "sh deploy.sh",
    "dtp": "sh tools/dtp.sh",
    "tdtp": "sh tools/tdtp.sh",
    "test:deploy": "sh tools/check-deploy-guards.sh"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "version": "2.2.0"
}
