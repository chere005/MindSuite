# /ChefMind/ after the app became MealMind (1.52.0). deploy.sh puts this folder
# at the old path, in place of the old app, once /MealMind/ is live and proven.
#
# Every request goes to the same place under /MealMind/, query string and all:
# bookmarks, home-screen installs and /ChefMind/index.html?x=1 alike. 302, the
# site's convention, and https written out with the request's own host,
# because NFSN forwards plain http to Apache (see the site's /request rule): a
# path-only target would bounce an https visitor out to http first, and
# HTTP_HOST keeps test. on test.
#
# EXCEPT sw.js. A browser that installed ChefMind's service worker checks
# /ChefMind/sw.js for an update, and it refuses a redirected worker script:
# the old worker would then stay and keep serving the cached ChefMind shell
# offline, forever. So sw.js is served here, as the worker that removes it.
RewriteEngine On

# ── Host routing first, and it has to live HERE ─────────────────────────────
#
# The site's root .htaccess maps test.seancheren.com/X to /test/X (dev. to
# /dev/X). That rule does NOT reach this directory: a directory whose
# .htaccess has rewrite rules of its own gets only those, and mod_rewrite does
# not apply a parent's rules there (CalMind's web.htaccess carries the same
# block for the same reason, after the subdomains were served PROD's
# directory). Without it, once this folder is PROD's /ChefMind/, every
# test.seancheren.com/ChefMind/ request would be answered here, by prod's
# redirect, and TEST's own /ChefMind/ (ChefMind's TEST copy, or the
# TestChefMind sandbox) could never be reached again.
#
# The same file goes to both instances, so it must be a no-op in the TEST one:
# under /home/public/test/ChefMind the request URI already starts with /test/,
# and the guard skips rather than rewriting to itself for ever. %{REQUEST_URI}
# rather than a fixed directory name, so the staged copy (ChefMind.next) maps
# to its own /test/ twin too.
RewriteCond %{HTTP_HOST} ^test\. [NC]
RewriteCond %{REQUEST_URI} !^/test/
RewriteRule ^ /test%{REQUEST_URI} [L]

RewriteCond %{HTTP_HOST} ^dev\. [NC]
RewriteCond %{REQUEST_URI} !^/dev/
RewriteRule ^ /dev%{REQUEST_URI} [L]

# …and on the apex, /test/ and /dev/ are a 404, as the site root has them:
# seancheren.com/test/ChefMind/ must not 302 an apex visitor into prod.
RewriteCond %{HTTP_HOST} !^(test|dev)\. [NC]
RewriteCond %{REQUEST_URI} ^/(test|dev)/
RewriteRule ^ - [R=404,L]

RewriteRule ^sw\.js$ - [L]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/MealMind/$1 [R=302,L]

# Never cached, or the browser would not pick the kill worker up.
<Files "sw.js">
  Header set Cache-Control "no-cache"
</Files>
